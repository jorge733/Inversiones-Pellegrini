# Copie este archivo como .env para probar el panel en su computador (npm run dev).
# En Vercel, configure estas mismas variables en Settings → Environment Variables.

# Texto largo y aleatorio para firmar la sesión del panel (mínimo 16 caracteres).
SECRETO_SESION=cambie-esto-por-un-texto-largo-y-aleatorio

# Contraseña del panel de administración (/admin).
CLAVE_ADMIN=escriba-aqui-la-contrasena-del-panel

# Solo en Vercel: token de GitHub con permiso de escritura sobre el repositorio
# (Contents: Read and write), para que el panel pueda guardar cambios.
# En el computador no se usa: los cambios se escriben directamente en los archivos.
# GITHUB_TOKEN=
